# Copy this file to .env and fill in your key. Never commit .env.
ANTHROPIC_API_KEY=
# Optional: override the model used by the Mirror's agents.
# ANDROIDMIRROR_MODEL=claude-opus-5-5
# Optional: needed to open the app from your phone (serve --host 0.0.0.0).
# Any user name works; this is the password. Use a long one.
# ANDROIDMIRROR_PASSWORD=
